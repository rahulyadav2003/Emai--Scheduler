# ==============================================
# Email Scheduler Service - Environment Variables
# ==============================================

# Backend Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_reachinbox_2026_change_in_production
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL
# If using Docker Compose (docker compose up -d):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/email_scheduler?schema=public

# Redis Connection (Used for BullMQ job queue & rate limit counters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Worker Concurrency & Rate Limit Defaults
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200

# Google OAuth 2.0 Credentials (Get from console.cloud.google.com)
# Authorized Redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Slack OAuth & Webhook (Optional / Stubbed)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# Frontend URL for Next.js App
NEXT_PUBLIC_API_URL=http://localhost:3001

